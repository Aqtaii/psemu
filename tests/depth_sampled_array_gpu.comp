
#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2DArrayShadow depth_image;
layout(set=0,binding=1,std430) buffer Output {float values[];};
layout(push_constant) uniform Push {uint base_layer;uint layers;} pc;
void main(){
 uvec3 p=gl_GlobalInvocationID;
 if(p.z>=pc.layers)return;
 float reference=(p.x&1u)!=0u?0.75:0.25;
 vec2 uv=(vec2(p.xy)+0.5)/vec2(64,32);
 values[(p.z*32+p.y)*64+p.x]=texture(depth_image,vec4(uv,float(p.z),reference));
}
