#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform writeonly image2D output_image;
layout(set=0,binding=1) uniform sampler2D sampled_image;
layout(push_constant) uniform Push {int sampled_levels;int target_mip;} pc;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,imageSize(output_image))))return;
 bool unorm_linear=pc.sampled_levels==1;
 vec4 initial=unorm_linear?vec4(0):vec4(0.125);
 bool valid=textureQueryLevels(sampled_image)==pc.sampled_levels && all(equal(texelFetch(sampled_image,p,min(pc.target_mip,pc.sampled_levels-1)),initial));
 vec4 written=unorm_linear?vec4(0,1,0,1):vec4(0.25,0.5,1,1);
 imageStore(output_image,p,valid?written:vec4(0));
}
