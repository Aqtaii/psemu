#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform writeonly image2D output_image;
layout(set=0,binding=1) uniform sampler2D sampled_image;
layout(push_constant) uniform Push {int source_component;int target_mip;} pc;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,imageSize(output_image))))return;
 bool valid=textureQueryLevels(sampled_image)==7 && all(equal(texelFetch(sampled_image,p,pc.target_mip),vec4(0.125)));
 imageStore(output_image,p,valid?vec4(0.25,0.5,1,1):vec4(0));
}
