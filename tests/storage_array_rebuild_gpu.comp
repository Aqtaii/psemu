#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2DArray source_image;
layout(std430,set=0,binding=1) buffer Result { uvec2 pixels[]; } result;
void main() {
    const ivec3 p=ivec3(gl_GlobalInvocationID);
    const ivec3 dimensions=textureSize(source_image,0);
    if(any(greaterThanEqual(p,dimensions)))return;
    const vec4 color=texelFetch(source_image,p,0);
    const uint index=(uint(p.z)*uint(dimensions.y)+uint(p.y))*uint(dimensions.x)+uint(p.x);
    result.pixels[index]=uvec2(packHalf2x16(color.rg),packHalf2x16(color.ba));
}
