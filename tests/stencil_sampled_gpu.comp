#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform usampler2D stencilTex;
layout(set=0,binding=1) uniform sampler2D depthTex;
layout(set=0,binding=2,std430) writeonly buffer Result {uint words[];} result;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);
 uint offset=(uint(p.y)*1920u+uint(p.x))*5u;
 uvec4 s=texelFetch(stencilTex,p,0);
 for(uint c=0;c<4;c++)result.words[offset+c]=s[c];
 result.words[offset+4]=floatBitsToUint(texelFetch(depthTex,p,0).r);
}
